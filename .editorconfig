root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
ij_continuation_indent_size = 8
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120
ij_visual_guides =

[{*.markdown,*.md}]
indent_style = space
indent_size = 2
tab_width = 2

[{*.yaml,*.yml}]
indent_size = 2
tab_width = 2
